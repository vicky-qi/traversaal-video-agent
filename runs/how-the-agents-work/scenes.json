      "scene_id": "s01",
      "title": "From prompt to video",
      "visual_type": "timeline",
      "target_duration_s": 30,
      "visual_notes": "Opens on the question as a headline, then a left-to-right pipeline timeline that lights up one stage per sentence: research, script and length fit, fact-check, scene build and stitch.",
      "narration": [
        {
          "id": "n1",
          "text": "Can a team of AI agents make a more reliable video than one prompt?",
          "claims": [],
          "on_screen": {
            "kind": "headline",
            "text": "Many agents vs one prompt?"
          }
        },
        {
          "id": "n2",
          "text": "This repository splits the job into stages that hand off files.",
          "claims": [
            "q1-f2"
          ],
          "on_screen": {
            "kind": "label",
            "text": "Stages hand off files in runs/<slug>/"
          }
        },
        {
          "id": "n3",
          "text": "After intake, one researcher per question gathers sourced facts in parallel.",
          "claims": [
            "q1-f1",
            "q1-f3",
            "q2-f3"
          ],
          "on_screen": {
            "kind": "point",
            "text": "Intake \u2192 parallel researchers"
          }
        },
        {
          "id": "n4",
          "text": "A scriptwriter cites fact ids for each factual sentence, then trims if the measured audio runs long.",
          "claims": [
            "q3-f1",
            "q1-f4",
            "q3-f3"
          ],
          "on_screen": {
            "kind": "point",
            "text": "Script \u2192 length fit"
          }
        },
        {
          "id": "n5",
          "text": "A fact-checker grades every line, scene builders work in parallel, and a tool renders and stitches the video.",
          "claims": [
            "q4-f2",
            "q1-f6"
          ],
          "on_screen": {
            "kind": "point",
            "text": "Fact-check \u2192 scene builders \u2192 MP4"
          }
        }
      ],
