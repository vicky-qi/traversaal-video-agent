      "narration": [
        {
          "id": "n1",
          "text": "Turning a single prompt into a seven-minute video is too much to do in one pass.",
          "on_screen": null
        },
        {
          "id": "n2",
          "text": "So our agent breaks the work into short scenes, and handles each one in three steps.",
          "on_screen": null
        },
        {
          "id": "n3",
          "text": "First, it researches the topic, and checks every claim against a source.",
          "on_screen": {
            "point": 1,
            "label": "Research & fact-check"
          }
        },
        {
          "id": "n4",
          "text": "Next, it writes the narration for each scene, and turns it into a voiceover.",
          "on_screen": {
            "point": 2,
            "label": "Script & voiceover"
          }
        },
        {
          "id": "n5",
          "text": "Finally, it builds visuals timed to that voice, and stitches every scene into one finished video.",
          "on_screen": {
            "point": 3,
            "label": "Visuals & assembly"
          }
        }
      ],
