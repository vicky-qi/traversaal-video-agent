    {
      "scene_id": "s02",
      "title": "Why it is built this way",
      "visual_type": "key_points",
      "target_duration_s": 30,
      "visual_notes": "Three design reasons appear as stacked points: verified before voiced, audio first, standalone scenes. The 40 percent overshoot shows as a stat beside the audio point; ends on the takeaway headline.",
      "narration": [
        {
          "id": "n1",
          "text": "In the first run, the fact-checker flagged two overstated lines, both genuine overgeneralizations.",
          "claims": [
            "q6-f4"
          ],
          "on_screen": {
            "kind": "stat",
            "text": "Overstated lines caught in round 1",
            "value": "2"
          }
        },
        {
          "id": "n2",
          "text": "Nothing it has not marked supported reaches the final voiceover.",
          "claims": [
            "q4-f4"
          ],
          "on_screen": {
            "kind": "point",
            "text": "Only supported lines are voiced"
          }
        },
        {
          "id": "n3",
          "text": "The first measured voiceover ran 40 percent long, so real audio is now measured and trimmed before fact-checking.",
          "claims": [
            "q5-f3",
            "q5-f2"
          ],
          "on_screen": {
            "kind": "stat",
            "text": "First voiceover vs target",
            "value": "+40%"
          }
        },
        {
          "id": "n4",
          "text": "Visuals are timed to the measured voice, and a broken scene is re-rendered alone.",
          "claims": [
            "q5-f1",
            "q6-f1"
          ],
          "on_screen": {
            "kind": "point",
            "text": "Visuals timed to voice, standalone scenes"
          }
        },
        {
          "id": "n5",
          "text": "The takeaway: small, checked hand-offs catch errors one agent would ship.",
          "claims": [
            "q6-f4"
          ],
          "on_screen": {
            "kind": "headline",
            "text": "Small, checked hand-offs"
